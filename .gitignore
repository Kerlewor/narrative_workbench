# Python
__pycache__/
*.py[cod]

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Generated runtime artifacts (not for version control)
.nw_index/

# Platform skill wrappers (generated by sync_skills.py)
.claude/skills/
.agents/skills/
.codex/

# Structured ledger data (runtime, project-specific)
story/ledger/*.jsonl

# Rendered views (generated by render_views.py)
# Template scaffolds (_*.md) are tracked; generated output (*.md) is not
story/views/*.md
!story/views/_*.md

# Generated plan artifacts (project-specific — keep templates)
story/plans/chapter-*.yaml
story/runtime/chapter-*.yaml
